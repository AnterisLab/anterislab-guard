
{
  "name": "@anterislab/guard",
  "version": "0.2.1",
  "description": "Real-time policy guard for autonomous agents: every action is evaluated against your plain-language policies before it executes. Fail-closed by construction.",
  "keywords": [
    "ai-agents",
    "guardrails",
    "policy-engine",
    "llm-safety",
    "autonomous-agents",
    "kill-switch",
    "audit-trail"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:coverage": "mkdir -p coverage && npm run build && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=./coverage/lcov.info test/*.test.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "prepack": "npm run build && npm run check:artifact",
    "prepublishOnly": "npm run build && npm run check:artifact"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.18.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnterisLab/anterislab-guard.git"
  },
  "bugs": {
    "url": "https://github.com/AnterisLab/anterislab-guard/issues"
  },
  "homepage": "https://www.anterislab.com",
  "author": "AnterisLab <hello@anterislab.com>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
